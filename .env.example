# App
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-random-64-character-string

# Admin accounts are created via: npm run create-admin <email> [role] [name]
# Stripe publishable key is configured in Admin > Settings (stored in DB, not here)

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# MailerSend
MAILERSEND_API_KEY=mlsn...
FROM_EMAIL=noreply@yellowstoneseahawkers.com

# Sender.net (optional — member list sync is skipped entirely if unset)
# Group IDs come from GET https://api.sender.net/v2/groups
SENDER_API_TOKEN=
SENDER_GROUP_CURRENT=
SENDER_GROUP_LAPSED=

# Membership expiry job (optional — leave blank/unset to disable)
# Flips lapsed members to status='expired' on a schedule. Runs in-process.
# EXPIRY_JOB_ENABLED must be exactly 'true' to arm it.
EXPIRY_JOB_ENABLED=
EXPIRY_JOB_CRON=0 3 * * *

# Seahawks schedule sync (optional — leave blank/unset to disable)
# Creates a game-day check-in event for each Seahawks game from ESPN's public schedule
# and keeps flexed kickoff times current. Admins can also run it from Admin > Events.
# SCHEDULE_SYNC_ENABLED must be exactly 'true' to arm it.
SCHEDULE_SYNC_ENABLED=
SCHEDULE_SYNC_CRON=0 4 * * 1

# hCaptcha
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

# Google Analytics (optional — leave blank to disable)
GA_MEASUREMENT_ID=

# PostgreSQL (optional — falls back to SQLite if not set)
# Setting DATABASE_URL switches the app from SQLite to PostgreSQL.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# For Render: uses the Internal Database URL from your Render dashboard.
# SSL is auto-enabled for non-localhost connections.

# Backblaze B2 Storage (optional — falls back to local disk if not set)
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=ysh-gallery
B2_KEY_ID=your-application-key-id
B2_APP_KEY=your-application-key
B2_PUBLIC_URL=https://f002.backblazeb2.com/file/ysh-gallery
