extends layout

block content
  section.section.alt-bg.membership-page
    if closed
      .container
        .text-center(style="padding: 3rem 0;")
          h2 Membership Closed
          p Membership is not currently open. Please check back soon!
    else
      .container
        .membership-layout
          .membership-benefits
            h2 Join the 12s
            p.benefits-tagline Yellowstone county's home for Seahawks fans. Here's what membership gets you:

            ul.benefits-list
              li.benefit-item
                .benefit-icon ✓
                .benefit-content
                  strong Watch Parties
                  p Join fellow 12s for every game, home and away, at our chapter's watch parties.
              li.benefit-item
                .benefit-icon ✓
                .benefit-content
                  strong Official Membership Card
                  p Receive your personalized YSH membership card, your badge of 12 pride.
              li.benefit-item
                .benefit-icon ✓
                .benefit-content
                  strong Member Discounts
                  p Exclusive discounts including reduced tickets for our annual pilgrimage to Lumen Field.

          .membership-form-panel
            .membership-tabs(role="tablist")
              button#tab-btn-new.membership-tab.membership-tab-active(type="button" role="tab" aria-selected="true" aria-controls="tab-new" data-tab="new") Become a Member
              button#tab-btn-renew.membership-tab(type="button" role="tab" aria-selected="false" aria-controls="tab-renew" data-tab="renew") Renew Membership

            //- ── Tab: New Member ──────────────────────────────────────
            //- Every field is present from the start. This form used to reveal itself a
            //- step at a time — plan, then captcha, then the fields — which left the
            //- panel showing two prices above 330px of blank white with nothing saying
            //- a click was expected.
            #tab-new(role="tabpanel" aria-labelledby="tab-btn-new")
              form.membership-form(method="POST" action="/membership")
                input(type="hidden" name="_csrf" value=(typeof csrfToken !== 'undefined' ? csrfToken : ''))

                fieldset.form-fieldset
                  legend.form-section-heading Choose your plan
                  - const indTotal = individualDues + surchargeCents
                  - const famTotal = familyDues + surchargeCents
                  .membership-type-cards
                    label.membership-type-card
                      input(type="radio" name="membership_type" value="individual" required)
                      .card-type-text
                        span.card-type-name Individual
                        span.card-type-price $#{(indTotal / 100).toFixed(2)}
                        span.card-type-detail
                          | $#{(individualDues / 100).toFixed(2)} dues
                          if surchargeCents > 0
                            |  + $#{(surchargeCents / 100).toFixed(2)} fee
                    label.membership-type-card
                      input(type="radio" name="membership_type" value="family" required)
                      .card-type-text
                        span.card-type-name Family
                        span.card-type-price $#{(famTotal / 100).toFixed(2)}
                        span.card-type-detail
                          | $#{(familyDues / 100).toFixed(2)} dues · up to #{maxFamilyMembers} members
                          if surchargeCents > 0
                            |  + $#{(surchargeCents / 100).toFixed(2)} fee

                fieldset.form-fieldset
                  legend.form-section-heading Your information
                  .form-grid-2
                    .form-group
                      label(for="first_name") First Name
                      input#first_name(type="text" name="first_name" autocomplete="given-name" required)
                    .form-group
                      label(for="last_name") Last Name
                      input#last_name(type="text" name="last_name" autocomplete="family-name" required)
                  .form-group
                    label(for="email") Email
                    input#email(type="email" name="email" autocomplete="email" required)
                  .form-group
                    label(for="phone")
                      | Phone&nbsp;
                      span.label-optional (optional)
                    input#phone(type="tel" name="phone" autocomplete="tel")

                fieldset.form-fieldset
                  legend.form-section-heading
                    | Mailing address&nbsp;
                    span.label-optional (optional)
                  .form-group
                    label(for="address_street") Street Address
                    input#address_street(type="text" name="address_street" autocomplete="address-line1")
                  .form-grid-2
                    .form-group
                      label(for="address_city") City
                      input#address_city(type="text" name="address_city" autocomplete="address-level2")
                    .form-group
                      label(for="address_state") State
                      input#address_state(type="text" name="address_state" value="MT" autocomplete="address-level1")
                  .form-group
                    label(for="address_zip") ZIP Code
                    input#address_zip(type="text" name="address_zip" autocomplete="postal-code" inputmode="numeric")

                //- Conditional on the plan, not a disclosure step: these fields only
                //- exist for a family membership.
                fieldset#family-members-section.form-fieldset(data-max=maxFamilyMembers hidden)
                  legend.form-section-heading Additional family members
                  p.form-hint You may add up to #{maxFamilyMembers - 1} additional family members. Each will receive their own membership card.
                  #family-members-container
                  p#family-members-limit.form-hint(hidden) That's the maximum of #{maxFamilyMembers - 1} additional members.
                  button.btn-outline.btn-add-family(type="button" id="add-family-member") + Add family member

                if hcaptchaSiteKey
                  .form-group.membership-captcha
                    p.form-section-heading Verify you're human
                    .h-captcha(data-sitekey=hcaptchaSiteKey)

                button.btn.btn-full(type="submit") Continue to Payment →

            //- ── Tab: Renew Membership ────────────────────────────────
            #tab-renew(role="tabpanel" aria-labelledby="tab-btn-renew" hidden)
              form(method="POST" action="/membership/renew-request")
                input(type="hidden" name="_csrf" value=(typeof csrfToken !== 'undefined' ? csrfToken : ''))

                p.form-section-heading Enter your email address
                p.form-hint We'll send a renewal link to the email address on your account.
                .form-group
                  label(for="renew_email") Email Address
                  input#renew_email(type="email" name="email" required autocomplete="email")

                if hcaptchaSiteKey
                  .form-group.membership-captcha
                    p.form-section-heading Verify you're human
                    .h-captcha(data-sitekey=hcaptchaSiteKey)

                button.btn.btn-full(type="submit") Send Renewal Link →

  script(src="/js/membership.js")
