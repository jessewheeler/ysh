extends ../layout

block content
  section#battle-of-the-birds.section
    .container
      h2 Battle of the Birds

      p.
        Battle of the Birds is our annual fundraiser, held each year when the Seahawks take on
        another, lesser bird team. It's a friendly competition between the Yellowstone Sea
        Hawkers and the local fans of whichever bird we're up against, and the real winners
        are the families we support.

      h3 Benefiting Billings Family Service
      p.
        All proceeds from Battle of the Birds go directly to
        #[a(href="https://billingsfamilyservice.org/" target="_blank" rel="noopener noreferrer") Billings Family Service],
        a nonprofit dedicated to strengthening families and individuals across the Yellowstone
        Valley through counseling, education, and support programs.

  section.section.alt-bg
    .container
      h3.text-center In the News

      //- Not an embed: the video owner has disabled off-site playback, so an iframe
      //- here renders a black "Video unavailable" box. This links out to the source.
      a.video-card(href="https://youtu.be/0S-kCaPTRlo" target="_blank" rel="noopener noreferrer")
        .video-card-media
          img(
            src="/img/ktvq-battle-of-the-birds.jpg"
            alt="KTVQ news coverage of a Battle of the Birds watch party in Billings"
            loading="lazy"
            width="1280"
            height="720"
          )
          span.video-card-play(aria-hidden="true")
        .video-card-body
          span.video-card-kicker KTVQ · November 2025
          span.video-card-title Seahawks fans in Billings turn game day into fundraising watch party
          span.video-card-cue Watch on YouTube

  section.section
    .container
      h3 How to Participate
      .cards.cards-three
        .card
          .card-body
            h3 Attend the Watch Party
            p Join us for the game and cheer on the Hawks. Entry fees and donations go to the cause.
        .card
          .card-body
            h3 Donate Directly
            p Can't make it? You can still support Billings Family Service with a direct donation.
            a.btn-outline(href="https://billingsfamilyservice.org/" target="_blank" rel="noopener noreferrer") Visit Billings Family Service
        .card
          .card-body
            h3 Spread the Word
            p Tell your friends and family about the event. Every bit of awareness helps.

  section.section.alt-bg
    .container
      a.btn-outline(href="/#charitable") &larr; Back to Charitable Work
