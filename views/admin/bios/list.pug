extends ../layout

block page_title
  | Bios

block content
  .admin-toolbar
    a.btn(href="/admin/bios/new") + New Bio

  if bios.length
    table.admin-table
      thead
        tr
          th Photo
          th Name
          th Role
          th Visible
          th Order
          th Actions
      tbody
        each bio in bios
          tr
            td
              if bio.photo_path
                img.avatar-sm(src=bio.photo_path alt=bio.name)
            td: a(href=`/admin/bios/${bio.id}`)= bio.name
            td= bio.role || '—'
            td= bio.is_visible ? 'Yes' : 'No'
            td= bio.sort_order
            td
              +rowActions(`/admin/bios/${bio.id}`, `/admin/bios/${bio.id}/delete`, 'Delete this bio?')
  else
    p.text-muted No bios yet.
