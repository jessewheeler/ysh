extends ../layout

block page_title
  | Announcements

block content
  .admin-toolbar
    a.btn(href="/admin/announcements/new") + New Announcement

  if announcements.length
    table.admin-table
      thead
        tr
          th Title
          th Published
          th Order
          th Actions
      tbody
        each ann in announcements
          tr
            td: a(href=`/admin/announcements/${ann.id}`)= ann.title
            td= ann.is_published ? 'Yes' : 'No'
            td= ann.sort_order
            td
              +rowActions(`/admin/announcements/${ann.id}`, `/admin/announcements/${ann.id}/delete`, 'Delete this announcement?')
  else
    p.text-muted No announcements yet.
