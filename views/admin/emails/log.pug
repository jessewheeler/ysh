extends ../layout

block page_title
  | Email Log

block content
  if emails.length
    table.admin-table
      thead
        tr
          th To
          th Subject
          th Type
          th Status
          th Date
      tbody
        each e in emails
          tr
            td= e.to_email
            td= e.subject
            td= e.email_type
            td= e.status
            td= formatDate(e.created_at)

    +pagination(page, totalPages, total, (n) => `/admin/emails?page=${n}`)
  else
    p.text-muted No emails sent yet.
