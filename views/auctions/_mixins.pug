//- Shared silent auction markup (issue #119).

//- The shipping and handling notice. It appears on every item page and the bid confirmation, so a winner can't say they weren't told.
mixin shippingNotice(text, compact)
  aside.auction-shipping(role="note" class=compact ? 'auction-shipping--compact' : null)
    strong Shipping &amp; handling:
    |  #{text}

//- When outbid emails go out (services/auctions.js#outbidEmailsOpen). Stated up front so
//- nobody expects an email on closing day.
mixin outbidNotice(win, compact)
  aside.auction-outbid-notice(role="note" data-outbid-notice class=compact ? 'auction-outbid-notice--compact' : null)
    strong Outbid alerts:
    if win.lastEmailDay
      |  We'll email you when you're outbid through #{win.lastEmailDay}. On closing day, #{win.closingDay}, the emails stop, so keep this page open; it updates live.
    else
      |  Outbid emails are off for this auction. Keep this page open; it updates live.

mixin money(cents)
  | $#{(Number(cents) / 100).toLocaleString('en-US')}

mixin phaseBadge(phase)
  //- A live auction gets no pill: the "closes in" countdown says it.
  case phase
    when 'live'
      - break
    when 'upcoming'
      span.auction-badge.auction-badge--upcoming Opens soon
    when 'closed'
      span.auction-badge.auction-badge--closed Closed
    default
      span.auction-badge Draft preview
